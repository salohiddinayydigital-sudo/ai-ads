{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tyrion://schemas/video-script-schema.json",
  "title": "Tyrion tyrion.video_script/v8 — `creative-matrix.py video-script --mode sales|organic|plan --json`",
  "type": "object",
  "required": [
    "schema",
    "mode",
    "lang",
    "duration_sec",
    "brief",
    "self_audit_checklist",
    "evidence_label"
  ],
  "properties": {
    "schema": {
      "const": "tyrion.video_script/v8"
    },
    "mode": {
      "enum": [
        "sales",
        "organic",
        "plan"
      ]
    },
    "lang": {
      "enum": [
        "uz",
        "ru",
        "en"
      ]
    },
    "duration_sec": {
      "enum": [
        15,
        30,
        45,
        60
      ]
    },
    "brief": {
      "type": "object",
      "required": [
        "business_product",
        "goal",
        "one_big_idea",
        "duration_sec"
      ],
      "properties": {
        "business_product": {
          "type": "string"
        },
        "goal": {
          "type": "string"
        },
        "awareness_stage": {
          "type": "string"
        },
        "one_big_idea": {
          "type": "string"
        },
        "duration_sec": {
          "type": "integer"
        }
      }
    },
    "modules": {
      "type": "object",
      "properties": {
        "hooks": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": [
              "hook_id",
              "mechanism",
              "visual_0_3s",
              "on_screen_text",
              "spoken_line"
            ],
            "properties": {
              "hook_id": {
                "type": "string"
              },
              "mechanism": {
                "type": "string"
              },
              "visual_0_3s": {
                "type": "string"
              },
              "on_screen_text": {
                "type": "string"
              },
              "spoken_line": {
                "type": "string"
              }
            }
          }
        },
        "bodies": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2
        },
        "ctas": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2
        },
        "combinations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "av_table": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "time",
          "start_s",
          "end_s",
          "stage",
          "visual",
          "vo",
          "on_screen_text",
          "camera_rhythm_sfx"
        ],
        "properties": {
          "time": {
            "type": "string",
            "pattern": "^\\d{2}:\\d{2}(\\.5)?-\\d{2}:\\d{2}(\\.5)?$"
          },
          "start_s": {
            "type": "number",
            "minimum": 0
          },
          "end_s": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "stage": {
            "type": "string"
          },
          "visual": {
            "type": "string"
          },
          "vo": {
            "type": "string"
          },
          "on_screen_text": {
            "type": "string"
          },
          "camera_rhythm_sfx": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          }
        }
      }
    },
    "content_matrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "n",
          "date",
          "platform",
          "funnel",
          "format",
          "primary_metric",
          "cta"
        ],
        "properties": {
          "n": {
            "type": "integer"
          },
          "date": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          },
          "funnel": {
            "enum": [
              "TOFU",
              "MOFU",
              "BOFU"
            ]
          },
          "format": {
            "type": "string"
          },
          "script_mode": {
            "enum": [
              "sales",
              "organic"
            ]
          },
          "primary_metric": {
            "type": "string"
          },
          "cta": {
            "type": "string"
          }
        }
      }
    },
    "batch_shooting_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "shoot_day",
          "videos",
          "locations",
          "outfits",
          "lighting"
        ],
        "properties": {
          "shoot_day": {
            "type": "integer",
            "minimum": 1
          },
          "videos": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "locations": {
            "type": "array",
            "minItems": 1
          },
          "outfits": {
            "type": "integer",
            "minimum": 1
          },
          "lighting": {
            "type": "string"
          }
        }
      }
    },
    "funnel_mix": {
      "type": "object",
      "required": [
        "counts",
        "target_shares",
        "evidence_label"
      ]
    },
    "production_notes": {
      "type": "object"
    },
    "self_audit_checklist": {
      "type": "object",
      "required": [
        "rubric",
        "pass_score",
        "automated_checks",
        "manual_criteria",
        "evidence_label"
      ],
      "properties": {
        "rubric": {
          "type": "string"
        },
        "pass_score": {
          "const": 85
        },
        "automated_checks": {
          "type": "object"
        },
        "manual_criteria": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "string"
          }
        },
        "evidence_label": {
          "enum": [
            "HEURISTIC_PRIOR_MODEL"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "claim_safety": {
      "type": "object"
    },
    "evidence_label": {
      "enum": [
        "HEURISTIC_PRIOR_MODEL"
      ]
    },
    "note": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "enum": [
              "sales",
              "organic"
            ]
          }
        }
      },
      "then": {
        "required": [
          "modules",
          "av_table",
          "production_notes"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "plan"
          }
        }
      },
      "then": {
        "required": [
          "content_matrix",
          "batch_shooting_plan",
          "funnel_mix"
        ]
      }
    }
  ]
}
