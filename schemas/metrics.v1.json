{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tyrion://schemas/metrics.v1.json",
  "title": "Tyrion metrics.v1 — normalized ad performance row",
  "description": "Bitta qator = bitta sana x entity. Fayl: {\"schema\":\"metrics.v1\",\"rows\":[...]} yoki rows massivi.",
  "type": "object",
  "required": ["schema", "rows"],
  "properties": {
    "schema": {"const": "metrics.v1"},
    "synthetic": {"type": "boolean"},
    "unmapped_columns": {"type": "array", "items": {"type": "string"}},
    "rows": {"type": "array", "items": {"$ref": "#/$defs/row"}}
  },
  "$defs": {
    "row": {
      "type": "object",
      "required": ["date", "platform", "account_id", "level", "entity_id", "spend", "currency", "source", "evidence_label", "synthetic"],
      "properties": {
        "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "platform": {"type": "string"},
        "account_id": {"type": "string"},
        "level": {"enum": ["campaign", "adset", "ad"]},
        "entity_id": {"type": "string"},
        "entity_name": {"type": "string"},
        "spend": {"type": "number", "minimum": 0},
        "currency": {"type": "string"},
        "impressions": {"type": "number", "minimum": 0},
        "reach": {"type": "number", "minimum": 0},
        "frequency": {"type": "number", "minimum": 0},
        "clicks": {"type": "number", "minimum": 0},
        "link_clicks": {"type": "number", "minimum": 0},
        "video_3s": {"type": "number", "minimum": 0},
        "thruplay": {"type": "number", "minimum": 0},
        "conversions": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}},
        "conversion_value": {"type": "number", "minimum": 0},
        "source": {"enum": ["meta_mcp", "meta_graph", "google_mcp", "csv", "screenshot"]},
        "evidence_label": {"enum": ["MEASURED_ACCOUNT_DATA", "PLATFORM_BENCHMARK", "HEURISTIC_PRIOR_MODEL", "USER_PROVIDED", "UNVERIFIED"]},
        "synthetic": {"type": "boolean"}
      },
      "additionalProperties": true
    }
  }
}
