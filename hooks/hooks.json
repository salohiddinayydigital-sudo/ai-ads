{
  "$comment": "Tyrion kanonik hook'lari. {{VAULT}} ni tools/install-hooks.py almashtiradi va .claude/settings.json ga qo'shadi. Bu fayl qo'lda o'zgartirilmaydi.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"{{VAULT}}/hooks/tyrion-hook.py\" brief",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"{{VAULT}}/hooks/tyrion-hook.py\" guard --warn-only --quiet",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"{{VAULT}}/hooks/tyrion-hook.py\" ingest --warn-only --quiet",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"{{VAULT}}/hooks/tyrion-hook.py\" dod --warn-only",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
