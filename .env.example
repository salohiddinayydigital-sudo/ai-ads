# Tyrion v5.0 Environment Variables (Example)
# Copy this file to .env and fill in your credentials. NEVER commit .env to git!

META_ACCESS_TOKEN=your_meta_access_token_here
META_AD_ACCOUNT_ID=act_1234567890
META_GRAPH_API_VERSION=v26.0
META_GRAPH_API_BASE_URL=https://graph.facebook.com

# Optional LLM / Graphify keys
# DEEPSEEK_API_KEY=your_deepseek_key_here
# GEMINI_API_KEY=your_gemini_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional Tyrion Hook Runtime Controls (ECC-compatible)
# TYRION_HOOK_PROFILE=standard   # minimal | standard | strict
# TYRION_DISABLED_HOOKS=         # comma-separated: session:brief,pre:guard,post:ingest,stop:dod
