# Tyrion Environment Variables (Example)
# Copy this file to .env and fill in your credentials. NEVER commit .env to git!

META_ACCESS_TOKEN=your_meta_access_token_here
META_AD_ACCOUNT_ID=act_1234567890
META_GRAPH_API_VERSION=v26.0
META_GRAPH_API_BASE_URL=https://graph.facebook.com

# Optional LLM / Graphify keys
# DEEPSEEK_API_KEY=your_deepseek_key_here
# GEMINI_API_KEY=your_gemini_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional Tyrion Hook Runtime Controls (ECC-compatible)
# TYRION_HOOK_PROFILE=standard   # minimal | standard | strict
# TYRION_DISABLED_HOOKS=         # comma-separated: session:brief,pre:guard,post:ingest,stop:dod

# Optional Tyrion Paths & Market (v8.0)
# TYRION_HOME=                   # where operator memory and instincts live (installed plugin default: ~/.tyrion)
# TYRION_DEFAULT_MARKET=uz       # market used when a task names no country, city or currency
# TYRION_MARKET=                 # force a market for every task (overrides detection)
